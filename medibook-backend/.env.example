PORT=5000

DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=<your_password_here>
DB_NAME=medibook

ADMIN_EMAIL=<your_admin_email_here>
ADMIN_PASSWORD=<your_admin_password_here>

GOOGLE_CLIENT_ID=<your_google_client_id_here>

JWT_SECRET=<your_jwt_secret_here>
JWT_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:3000

# Email is optional in development. Leave MAIL_ENABLED=false to skip sending emails.
MAIL_ENABLED=false
MAIL_SERVICE=gmail
MAIL_USER=<your_gmail_address_here>
MAIL_FROM=MediBook <your_gmail_address_here>

# Use a Gmail App Password, not your normal Google account password.
MAIL_PASS=<your_gmail_app_password_here>

# Optional Gmail OAuth2 alternative to MAIL_PASS.
# MAIL_CLIENT_ID=<your_oauth_client_id_here>
# MAIL_CLIENT_SECRET=<your_oauth_client_secret_here>
# MAIL_REFRESH_TOKEN=<your_oauth_refresh_token_here>
CLOUDINARY_CLOUD_NAME=<your_cloudinary_cloud_name_here>
CLOUDINARY_API_KEY=<your_cloudinary_api_key_here>
CLOUDINARY_API_SECRET=<your_cloudinary_api_secret_here>